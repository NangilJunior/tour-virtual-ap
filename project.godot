; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tour Virtual AP"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/autobake/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; Web só roda o renderizador Compatibility (WebGL2) — Forward+ depende de
; Vulkan. O lightmap assado continua valendo; SSAO/SSIL/SSR/DOF não existem
; nesse renderizador e simplesmente não aparecem no navegador.
renderer/rendering_method.web="gl_compatibility"
driver/threads/thread_model=2
; Sem SharedArrayBuffer (que exigiria headers COOP/COEP no servidor), o build
; web é de thread única.
driver/threads/thread_model.web=0
; Formato de textura que os navegadores de celular entendem (ETC2/ASTC);
; o desktop segue usando S3TC/BPTC como sempre.
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
reflections/reflection_atlas/reflection_size=512
reflections/reflection_atlas/reflection_count=8
textures/default_filters/anisotropic_filtering_level=4
environment/ssil/quality=3
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=1
; FSR só existe no Forward+; no navegador (Compatibility) ele apenas avisa
; que não vai funcionar, então lá fica na escala bilinear padrão.
scaling_3d/mode.web=0
scaling_3d/mode.ios=1
scaling_3d/mode.macos=1
mesh_lod/lod_change/threshold_pixels=2.0
environment/screen_space_reflection/roughness_quality=2

[xr]

openxr/enabled=true
shaders/enabled=true
