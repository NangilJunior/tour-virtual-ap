[gd_resource type="StandardMaterial3D" load_steps=5 format=3]

; Revestimento das paredes dos banheiros (material tex_textura_29 do .blend).
; Vinha do SketchUp só com albedo e roughness 0.5, o que dava um porcelanato
; polido com cara de reboco fosco. Os mapas foram derivados do próprio albedo
; por tools/gerar_pbr.py.
;
; Sem uv1_triplanar: ao contrário das paredes de reboco, estas faces têm UV
; boa vinda do SketchUp (span ~2.6), e projetar triplanar por cima quebraria a
; escala da peça.

[ext_resource type="Texture2D" path="res://assets/Apartamento/textures/11.jpg" id="1_albedo"]
[ext_resource type="Texture2D" path="res://assets/Apartamento/textures/11_normal.png" id="2_normal"]
[ext_resource type="Texture2D" path="res://assets/Apartamento/textures/11_ao.png" id="3_ao"]
[ext_resource type="Texture2D" path="res://assets/Apartamento/textures/11_roughness.png" id="4_roughness"]

[resource]
resource_name = "porcelanato_onix_pbr"
albedo_texture = ExtResource("1_albedo")
roughness = 1.0
roughness_texture = ExtResource("4_roughness")
normal_enabled = true
normal_scale = 0.8
normal_texture = ExtResource("2_normal")
ao_enabled = true
ao_light_affect = 0.3
ao_texture = ExtResource("3_ao")
texture_filter = 5
